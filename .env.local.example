# Copy this to .env.local and fill in the blanks. .env.local is gitignored —
# never commit real tokens.

# --- Caspian gateway ---------------------------------------------------
# Mint a free sandbox key with no sign-in required:
#   curl -X POST https://api.trycaspianai.com/v1/projects/sandbox -d '{"name":"deadline-agent"}'
# or install the CLI and run `caspian init`. Free channels (email, Telegram,
# Discord, Slack, Bluesky) need nothing beyond this key.
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather on Telegram; it gives you this token directly.
# TELEGRAM_CHAT_ID is not required by the code (Caspian tracks conversations
# by conversation_id internally) — it's listed here only as a human-readable
# reminder of which chat you tested against, if you want to jot it down.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ---------------------------------------------------------------
# Create an application + bot at https://discord.com/developers/applications,
# then Bot -> Reset Token to get DISCORD_BOT_TOKEN.
#
# REQUIRED, easy to miss: on that same Bot page, under "Privileged Gateway
# Intents", enable "MESSAGE CONTENT INTENT". Without it, Discord will not
# deliver message text to the bot at all — commands silently do nothing.
#
# DISCORD_CHANNEL_ID is not required by the code (same reasoning as
# TELEGRAM_CHAT_ID above) — a human-readable note of which channel you
# invited the bot into and tested in.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Featherless (inference partner) ---------------------------------------
# Optional. Powers the two-layer "AI on top" fallback (core/ai_fallback.py):
# free-form messages that don't match /add, /list, /remove, /help get one
# attempt at being rewritten into a real command before falling back to the
# plain help hint. The product works fully without this section set.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324
